{
  "$schema": "https://design-tokens.org/draft",
  "groups": {
    "surface": {
      "--ground": "#F8F5F3",
      "--paper": "#FFFFFF",
      "--tint": "#EDF6F2",
      "--dark": "#12202F"
    },
    "ink": {
      "--ink": "#12202F",
      "--ink-2": "#53616D",
      "--ink-3": "#7C8794",
      "--on-dark": "rgba(240, 245, 248, .76)",
      "--on-dark-str": "#FFFFFF",
      "--dark-line": "rgba(255, 255, 255, .14)"
    },
    "identity": {
      "--navy": "#1E3A63"
    },
    "accent": {
      "--mint": "#8FDCC6",
      "--mint-dp": "#0B6353",
      "--mint-sf": "#DFF3EC",
      "--apricot": "#F5C09A",
      "--apr-dp": "#9A5320",
      "--apr-sf": "#FCEBDD",
      "--lilac": "#C9C4EA",
      "--lil-dp": "#514697",
      "--lil-sf": "#EAE7F8",
      "--gold": "#C68B3C"
    },
    "line": {
      "--line": "rgba(18, 32, 47, .10)",
      "--line-2": "rgba(18, 32, 47, .16)",
      "--shadow": "0 1px 2px rgba(18, 32, 47, .04), 0 14px 34px -16px rgba(18, 32, 47, .18)"
    },
    "geometry": {
      "--r": "26px",
      "--r-sm": "14px",
      "--r-pill": "999px",
      "--unit": "4px",
      "--band-pad": "clamp(64px, 9vw, 128px)",
      "--wrap": "1180px"
    },
    "type": {
      "--display": "Gabarito, \"Segoe UI Variable Display\", system-ui, sans-serif",
      "--body": "Manrope, \"Segoe UI Variable Text\", system-ui, -apple-system, sans-serif",
      "--mono": "ui-monospace, \"Cascadia Mono\", \"SF Mono\", Menlo, Consolas, monospace",
      "--t-hero": "clamp(42px, 6.5vw, 76px)",
      "--t-h2": "clamp(30px, 4.2vw, 46px)",
      "--t-h3": "clamp(28px, 3.6vw, 42px)",
      "--t-card": "20px",
      "--t-body": "16px",
      "--t-small": "14.5px",
      "--t-eyebrow": "12px"
    }
  }
}
