# Secrets
.env
.env.local
credentials.json
token.json
*.token_cache.json
client_secret_*.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
ENV/

# .tmp/ caches — structure tracked, contents not
.tmp/search_cache/*.json
.tmp/web_cache/*
!.tmp/search_cache/README.md
!.tmp/web_cache/README.md
# .tmp/scripts/ IS tracked — shared utilities
!.tmp/scripts/**
# ...but the blanket un-ignore above also re-includes bytecode, so re-exclude it
.tmp/scripts/**/__pycache__/
# ...and NOT secrets
.tmp/scripts/credentials.json
.tmp/scripts/service-account.json
.tmp/scripts/token*.json

# OS / IDE
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Generated site builds — fully reproducible with `python site/build.py`.
# The generators and content are tracked; their output is not.
outputs/*/site/dist/
outputs/*/site/dist-prod/
# Webfonts staged for a build are copies of the cache in agent-data/fonts/,
# which IS tracked. `brandkit.py apply` re-stages them.
outputs/*/site/assets/fonts/

# Ad-hoc verification/debug screenshots dropped at repo root instead of .tmp/screenshots/
/*.png
/*.jpg
/*.jpeg

# Keep .vscode/ settings
!.vscode/
# ...except mcp.json — it holds a live MCP auth header (WordPress app password)
.vscode/mcp.json

# Live-editor version timeline — machine-local working state, not site content.
# The site itself is versioned in git; this is the in-session undo history.
outputs/*/site/.versions/

# Live-editor feedback notes — per-session review scratch, not site content.
outputs/*/site/.feedback/

# Claude Code: settings.json IS shared (hooks the whole team needs).
# settings.local.json is per-machine — MCP enable/disable, local permissions.
.claude/settings.local.json
